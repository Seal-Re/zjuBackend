# Fastop 本地栈环境变量样例
# 用法: cp .env.example .env  然后 docker compose -f docker-compose.yml --env-file .env up -d

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=Fastop@123
MYSQL_DATABASE=autosys_1014

# ---- Fastop Backend EMS 集成 ----
# 默认空 = 不下发 EMS（执行步骤接口会返回失败）
# 若并入 EMS，可设为 http://affair-center:8080
FASTOP_EMS_URL=
FASTOP_EMS_SEND_PATH=/addDefault
FASTOP_EMS_ABILITY_DEFAULT=fastop.send

# ---- 前端打包注入 ----
VITE_API_BASE=/api
VITE_AUTH_API_BASE=/auth-api
