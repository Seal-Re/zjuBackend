# 多阶段构建 fastop Spring Boot 主服务
# 构建上下文为仓库根目录（docker-compose 已设 context: ..）

# ---------- Stage 1: 构建 ----------
FROM maven:3.9-eclipse-temurin-8 AS builder
WORKDIR /build

# 先单独 COPY pom.xml 树，最大化 Maven 依赖层缓存
COPY fastop/pom.xml fastop/pom.xml
COPY fastop/fastop-base/pom.xml fastop/fastop-base/pom.xml
COPY fastop/fastop-base/fastop-base-common/pom.xml fastop/fastop-base/fastop-base-common/pom.xml
COPY fastop/fastop-model/pom.xml fastop/fastop-model/pom.xml
COPY fastop/fastop-model/fastop-model-designer/pom.xml fastop/fastop-model/fastop-model-designer/pom.xml
COPY fastop/fastop-model/fastop-model-planner/pom.xml fastop/fastop-model/fastop-model-planner/pom.xml
COPY fastop/fastop-dal/pom.xml fastop/fastop-dal/pom.xml
COPY fastop/fastop-dal/fastop-dal-designer/pom.xml fastop/fastop-dal/fastop-dal-designer/pom.xml
COPY fastop/fastop-service/pom.xml fastop/fastop-service/pom.xml
RUN cd fastop && mvn -B -q -e -fae dependency:go-offline || true

# 再 COPY 源码并打包
COPY fastop/ fastop/
RUN cd fastop && mvn -B -DskipTests clean package

# ---------- Stage 2: 运行 ----------
FROM eclipse-temurin:8-jre
WORKDIR /app

ENV TZ=Asia/Shanghai \
    JAVA_TOOL_OPTIONS="-Xms256m -Xmx1024m -Duser.timezone=Asia/Shanghai"

COPY --from=builder /build/fastop/fastop-service/target/*.jar /app/fastop.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/fastop.jar"]
