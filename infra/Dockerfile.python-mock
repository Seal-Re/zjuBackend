# 通用 Python Mock 服务镜像（auth-mock-service 与 device-controller-mock 共用）
# 构建上下文为各 mock 项目目录（含 app.py + requirements.txt）
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MOCK_HOST=0.0.0.0 \
    MOCK_PORT=5000

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py ./

# 容器内统一以 0.0.0.0 监听 — 使用 FLASK_RUN_HOST/PORT 避开 app.py 中的 127.0.0.1 默认
# app.py 里 if __name__ == "__main__": app.run(host="127.0.0.1", ...) 不被 flask CLI 触发，保证容器外可访问
CMD ["sh", "-c", "flask --app app run --host=${MOCK_HOST} --port=${MOCK_PORT}"]
